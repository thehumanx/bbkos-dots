<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1792283569536788-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>image-x-generic</icon>
	<name>Set as wallpaper</name>
	<submenu></submenu>
	<unique-id>1792283569536789-2</unique-id>
	<command>sh -c 'out=$(bbkos-theme wallpaper set -- "$1" 2&gt;&amp;1) || notify-send -u critical "Set as wallpaper failed" "$out"' sh %f</command>
	<description>Use this image as the wallpaper and recolour the system</description>
	<range></range>
	<patterns>*.png;*.jpg;*.jpeg;*.webp;*.bmp;*.gif;*.PNG;*.JPG;*.JPEG;*.WEBP;*.BMP;*.GIF</patterns>
	<image-files/>
</action>
</actions>
