#!/usr/bin/env bash
# bbkos-ocr: drag a region of the screen, recognise its text and copy the text to the clipboard (docs/modules/capture.md).
# The same job as Omarchy's omarchy-capture-text: slurp picks the region, grim captures it, tesseract reads it, wl-copy
# copies it. The capture is enlarged 2x (Lanczos) first: measured 2026-10-21 on screenshots of the settings window,
# Tesseract found 91% of the words at 1x and 96% at 2x. Languages: BBKOS_OCR_LANGS (default eng; needs the
# tesseract-data-<lang> package). BBKOS_OCR_REGION="X,Y WxH" replaces the picker (a test hook). Esc cancels.
set -euo pipefail

region="${BBKOS_OCR_REGION:-}"
[ -n "$region" ] || region=$(slurp 2>/dev/null) || exit 0
[ -n "$region" ] || exit 0

notify() { notify-send -a bbkos-ocr -t 4000 "$@" >/dev/null 2>&1 || true; }

text=$(grim -g "$region" - \
    | ffmpeg -loglevel error -i - -vf "scale=iw*2:ih*2:flags=lanczos" -f image2pipe -c:v png - \
    | tesseract stdin stdout --oem 1 --psm 6 -l "${BBKOS_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || {
    notify "Could not read text" "Is tesseract installed with the language data?"; exit 1; }

if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
    notify "No text found" "Nothing was copied."
    exit 1
fi
printf '%s' "$text" | wl-copy
notify "Text copied" "$(printf '%s' "$text" | head -c 120)"
