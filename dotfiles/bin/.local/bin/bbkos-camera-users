#!/usr/bin/env python3
"""bbkos-camera-users: JSON list of the programs that hold a camera device (/dev/video*) open, one entry per program
(the same as `bbkos-camera users`; docs/modules/privacy.md)."""
import os
import sys

sys.dont_write_bytecode = True  # the package is Stow-linked into the repo
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from bbkos_theme.camera import main  # noqa: E402

sys.exit(main(["users"]))
