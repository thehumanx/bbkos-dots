pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Theme values generated by `bbkos-theme` (~/.local/state/bbkos/theme/colors.json) and the owner's settings
// (~/.config/bbkos/settings.json), watched live. Every value has today's built-in look as its default, per key:
// - file missing: defaults;
// - file unparsable or not a JSON object: the last good contents stay (defaults if none was ever read);
// - key missing, wrong type, not #rrggbb (colours), not a finite size in range, or not one of an enum's values: that
//   key's default.
// Nothing here throws. Consumers bind to `colors` / `shell` (Theme.qml does), never read them once.
// The tool replaces colors.json by rename (new inode); see docs/modules/theme.md for how that was verified.
Singleton {
    id: root

    readonly property var defaultColors: ({
        bg: "#101014", surface: "#1b1b22", fg: "#e6e6ea", dim: "#a7a8b3",
        accent: "#7fa8fd", warn: "#e0af68", crit: "#ff8298",
        // Not used by the shell yet. Defaults: dim for outline, Hyprland's former border colours for the rest.
        outline: "#a7a8b3", borderActive1: "#33ccff", borderActive2: "#00ff99", borderInactive: "#595959",
        // Wallpaper tints (bbkos-theme `tints`): two more accent hues, the deep shade of each, a raised surface.
        secondary: "#9ece6a", tertiary: "#bb9af7", accentSoft: "#2a3a5c", secondarySoft: "#2f3d22", tertiarySoft: "#3d2f5c",
        surfaceHigh: "#25252e", gridEdge: "#3b3b44"
    })
    // [default, min, max]: the schema ranges of docs/specs (section 4), with a little slack for fonts.
    readonly property var shellLimits: ({
        barHeight: [30, 16, 96], gap: [12, 0, 64], radius: [12, 0, 48], controlRadius: [6, 0, 32], fontSize: [13, 6, 40],
        pillRadius: [8, 0, 16], barItemGap: [12, 0, 32], barItemPad: [0, 0, 24], barFloat: [0, 0, 24], barRadius: [0, 0, 24]
    })
    // [default, min, max] for the other fractional bar/colour values (kept fractional, like barOpacity).
    readonly property var pillOpacityLimits: [1.0, 0.0, 1.0]
    readonly property var barBlurAmountLimits: [0.5, 0.05, 1.0]
    readonly property var tintLimits: [0.8, 0.0, 1.0]
    readonly property var popupShadowLimits: [0.5, 0.0, 1.0]
    // Bar keys that are not whole numbers: opacity [default, min, max] (kept fractional), enums [default, ...allowed].
    readonly property var barOpacityLimits: [1.0, 0.2, 1.0]
    readonly property var shellEnums: ({
        barPosition: ["top", "top", "bottom", "left", "right"],
        barPills: ["off", "off", "grouped", "individual"]
    })
    readonly property string defaultFont: "JetBrainsMono Nerd Font"

    readonly property string home: Quickshell.env("HOME") ?? ""
    readonly property string colorsPath: home + "/.local/state/bbkos/theme/colors.json"
    readonly property string settingsPath: home + "/.config/bbkos/settings.json"

    // Last good parsed documents ({} = nothing usable yet, i.e. all defaults).
    property var colorsDoc: ({})
    property var settingsDoc: ({})

    readonly property var colors: pickColors(colorsDoc)
    readonly property var shell: pickShell(colorsDoc)
    readonly property var settings: settingsDoc
    readonly property string wallpaperPath: {
        const w = settingsDoc.wallpaper
        return (isObject(w) && typeof w.path === "string") ? w.path : ""
    }

    function reload() {
        colorsFile.reload()
        settingsFile.reload()
    }

    function isObject(v) { return v !== null && typeof v === "object" && !Array.isArray(v) }

    function pickColors(doc) {
        const src = isObject(doc) && isObject(doc.colors) ? doc.colors : {}
        const out = {}
        for (const k in defaultColors) {
            const v = src[k]
            out[k] = (typeof v === "string" && /^#[0-9a-fA-F]{6}$/.test(v)) ? v.toLowerCase() : defaultColors[k]
        }
        return out
    }

    function pickFraction(v, limits) {
        const [def, lo, hi] = limits
        return (typeof v === "number" && isFinite(v) && v >= lo && v <= hi) ? v : def
    }

    function pickShell(doc) {
        const src = isObject(doc) && isObject(doc.shell) ? doc.shell : {}
        const out = {}
        for (const k in shellLimits) {
            const [def, lo, hi] = shellLimits[k]
            const v = src[k]
            out[k] = (typeof v === "number" && isFinite(v) && v >= lo && v <= hi) ? Math.round(v) : def
        }
        const f = src.font
        out.font = (typeof f === "string" && f.trim() !== "") ? f : defaultFont
        const [odef, olo, ohi] = barOpacityLimits
        const o = src.barOpacity
        out.barOpacity = (typeof o === "number" && isFinite(o) && o >= olo && o <= ohi) ? o : odef
        const [pdef, plo, phi] = pillOpacityLimits
        const p = src.pillOpacity
        out.pillOpacity = (typeof p === "number" && isFinite(p) && p >= plo && p <= phi) ? p : pdef
        out.barBlurAmount = pickFraction(src.barBlurAmount, barBlurAmountLimits)
        out.tint = pickFraction(src.tint, tintLimits)
        out.popupShadow = pickFraction(src.popupShadow, popupShadowLimits)
        for (const k in shellEnums) {
            const [def, ...allowed] = shellEnums[k]
            out[k] = (typeof src[k] === "string" && allowed.includes(src[k])) ? src[k] : def
        }
        out.barBlur = src.barBlur === true
        out.barHug = src.barHug === true
        out.reduceMotion = src.reduceMotion === true
        out.gridMode = src.gridMode === true
        out.gridRoundControls = src.gridRoundControls === true
        return out
    }

    // Parse a file's text. Returns the object, or null when it is not a JSON object (caller keeps the last good one).
    function parse(text, label) {
        try {
            const v = JSON.parse(text)
            if (isObject(v)) return v
            console.warn("ThemeStore: " + label + " is not a JSON object; keeping the last good values")
        } catch (e) {
            console.warn("ThemeStore: " + label + " is not valid JSON; keeping the last good values")
        }
        return null
    }

    Component.onCompleted: {
        // First read: text() blocks (blockLoading) and fills the documents before the first frame.
        const c = colorsFile.text(); if (colorsFile.loaded) colorsDoc = parse(c, "colors.json") ?? colorsDoc
        const s = settingsFile.text(); if (settingsFile.loaded) settingsDoc = parse(s, "settings.json") ?? settingsDoc
    }

    FileView {
        id: colorsFile
        path: root.colorsPath
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        blockLoading: true        // tiny file: the first read is synchronous, so the shell never flashes the defaults
        onLoaded: root.colorsDoc = root.parse(text(), "colors.json") ?? root.colorsDoc
        onLoadFailed: error => {
            if (error === FileViewError.FileNotFound) root.colorsDoc = {}   // no generated theme: today's look
        }
    }

    FileView {
        id: settingsFile
        path: root.settingsPath
        watchChanges: true
        printErrors: false
        onFileChanged: reload()
        blockLoading: true        // tiny file: the first read is synchronous, so the shell never flashes the defaults
        onLoaded: root.settingsDoc = root.parse(text(), "settings.json") ?? root.settingsDoc
        onLoadFailed: error => {
            if (error === FileViewError.FileNotFound) root.settingsDoc = {}
        }
    }
}
