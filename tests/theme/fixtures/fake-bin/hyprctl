#!/bin/sh
# Fake hyprctl: records argv (one call per line, args NUL-free, tab-separated)
# to $FAKE_HYPRCTL_LOG. `monitors all -j` prints the file $FAKE_HYPRCTL_MONITORS; `cursorpos` prints $FAKE_HYPRCTL_CURSORPOS. `configerrors` prints $FAKE_HYPRCTL_CONFIGERRORS.
log=${FAKE_HYPRCTL_LOG:-/dev/null}
first=1
for a in "$@"; do
    if [ $first = 1 ]; then printf '%s' "$a" >> "$log"; first=0
    else printf '\t%s' "$a" >> "$log"; fi
done
printf '\n' >> "$log"
if [ "$1" = configerrors ]; then
    printf '%s' "${FAKE_HYPRCTL_CONFIGERRORS:-}"
    exit 0
fi
if [ "$1 $2 $3" = "monitors all -j" ] && [ -n "${FAKE_HYPRCTL_MONITORS:-}" ]; then
    cat "$FAKE_HYPRCTL_MONITORS"
    exit 0
fi
if [ "$1" = cursorpos ]; then
    echo "${FAKE_HYPRCTL_CURSORPOS:-0, 0}"
    exit 0
fi
[ -n "${FAKE_HYPRCTL_FAIL:-}" ] && { echo "fake hyprctl failure" >&2; exit 1; }
echo ok
